# ─────────────────────────────────────────────
# NexTask environment variables
# Copy this file to ".env" and fill in real values.
# ".env" is gitignored — never commit real secrets.
# ─────────────────────────────────────────────

# ── Backend (set these on the Render Web Service) ──
NODE_ENV=development

# Port the server listens on. Render sets PORT automatically,
# so you can leave this unset in production.
PORT=5000

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_URI=your_mongodb_connection_string

# Secret used to sign JWT access tokens
JWT_ACCESS_SECRET=your_jwt_secret

# Access token lifetime (optional, defaults to "24h")
JWT_ACCESS_EXPIRES_IN=24h

# ── Frontend (set these on the Render Static Site) ──
# Base URL of the backend API. Point at your backend's Render URL in prod,
# e.g. https://nextask-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Base URL of the backend for Socket.io. Same host, no /api suffix,
# e.g. https://nextask-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000
